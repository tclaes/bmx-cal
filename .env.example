# Copy to .env and fill in real values. Never commit .env.
# `npm run dev` ignores these and uses the local stack (.env.e2e.local, from `npm run test-env:start`).
# These values are only used by `npm run dev:remote` and by production builds.
# Browser-exposed (safe to publish):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GA_MEASUREMENT_ID=
VITE_VAPID_PUBLIC_KEY=

# Server-side secrets. Keep these out of the browser bundle (no VITE_ prefix)
# and out of version control. Rotate them if they are ever shared.
SUPABASE_SERVICE_ROLE_KEY=
