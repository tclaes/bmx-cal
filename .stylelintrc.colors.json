{
  "rules": {
    "color-no-hex": true,
    "function-disallowed-list": [
      "rgb",
      "rgba",
      "hsl",
      "hsla",
      "hwb",
      "lab",
      "lch",
      "oklab",
      "oklch",
      "color"
    ],
    "declaration-property-value-disallowed-list": {
      "/^(color|background|background-color|background-image|border(-[a-z]+)*|outline(-color)?|fill|stroke|box-shadow|text-shadow|caret-color|text-decoration(-color)?|accent-color)$/": [
        "/(^|\\s)(white|black|red|green|blue|gray|grey|orange|yellow|purple|pink|brown|cyan|magenta|silver|navy|teal|maroon|lime|aqua|fuchsia|olive)(\\s|;|$)/i"
      ],
      "/^[a-z]/": [
        "/var\\(--palette-/"
      ]
    }
  },
  "ignoreFiles": [
    "dist/**/*",
    "node_modules/**/*"
  ],
  "overrides": [
    {
      "files": [
        "**/*.svelte"
      ],
      "customSyntax": "postcss-html"
    },
    {
      "files": [
        "src/styles/colors.css"
      ],
      "rules": {
        "color-no-hex": null,
        "function-disallowed-list": null
      }
    }
  ]
}
